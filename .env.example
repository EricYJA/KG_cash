# KG_cash environment configuration.
#
# Copy to `.env` at the repository root and fill in the values:
#     cp .env.example .env
#
# `.env` is gitignored — never commit real keys. The runners in scripts/ read
# this file directly (see scripts/_rog_common.py:load_dotenv); values already
# exported in your shell take precedence and are not overwritten.

# ─── Required: LLM access ──────────────────────────────────────────────────────

# A single key serves whichever vendor you select with `--vendor`. There are no
# separate per-vendor key variables: point this at the provider you are using.
#   tamu    -> https://chat-api.tamu.ai/openai
#   openai  -> https://api.openai.com/v1
#   google  -> https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=

# ─── Required for RoG runs: HuggingFace ────────────────────────────────────────

# Used to download rmanluo/RoG for the containerized planner/reasoner. Not
# needed for ToG-only runs. Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# ─── Optional: defaults for the experiment runners ─────────────────────────────

# Default for `--model`. Leave empty to use the vendor preset:
#   tamu -> protected.Claude-Haiku-4.5
#   openai -> gpt-4.1-mini
#   google -> gemini-3-flash-preview
# MODEL=

# Which SPARQL backend serves the Freebase KG. Both are interchangeable and are
# defined in docker-compose.yml. Default: virtuoso
# KG_BACKEND=virtuoso        # virtuoso | oxigraph

# Explicit SPARQL endpoint. Overrides KG_BACKEND when set, so leave it unset
# unless you are pointing at a non-default host or port.
#   virtuoso -> http://localhost:8890/sparql
#   oxigraph -> http://localhost:7878/query
# SPARQL_ENDPOINT=

# Default for `--run-tag`, which names the output directory under
# artifacts/rog_cache/ or artifacts/tog_cache/.
# RUN_TAG=

# Conda environment the ToG runners launch subprocesses in. Default: KG_cash
# CONDA_ENV=KG_cash

# ─── Optional: Virtuoso container tuning (docker-compose.yml) ──────────────────

# Defaults shown. NumberOfBuffers/MaxDirtyBuffers are sized for roughly 8 GB of
# RAM; lower them on a smaller machine.
# VIRTUOSO_DBA_PASSWORD=dba
# VIRTUOSO_BUFFERS=680000
# VIRTUOSO_MAX_DIRTY_BUFFERS=500000
