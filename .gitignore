# --- Experiment results -------------------------------------------------
# Only the per-run summaries are committed: they are the sole input to every
# plotting and table script. The bulk run output (predictions, cache blobs,
# per-policy jsonl) is ~1.6 GB and regenerable. Part of it also embeds ':' in
# path names (run tags like test[:10]), which makes a Windows checkout fail.
artifacts/rog_cache/**
!artifacts/rog_cache/**/
!artifacts/rog_cache/**/summary.json
!artifacts/rog_cache/**/summary.csv

artifacts/tog_cache/**
!artifacts/tog_cache/**/
!artifacts/tog_cache/**/summary.json

src/ToG-cache/output/compare_caches/
src/ToG-cache/output/compare_results/**
!src/ToG-cache/output/compare_results/**/
!src/ToG-cache/output/compare_results/**/summary.json

